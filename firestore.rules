rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar roles administrativos
    function hasAdminRole(role) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isStaff() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['administrator', 'asistente', 'vendedor'];
    }

    // PERFILES DE USUARIO
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isStaff());
      // Permitir escribir el propio perfil SOLO SI NO SE ESTÁ INTENTANDO CAMBIAR EL ROL
      allow write: if request.auth != null && request.auth.uid == userId && (
        !('role' in request.resource.data) || 
        resource.data.role == request.resource.data.role ||
        // Permitir creación inicial si el rol es 'cliente' (o por defecto) pero esto se maneja usualmente en backend o con reglas más complejas.
        // Asumimos que la creación inicial crítica (con roles) la hace el Admin SDK.
        !exists(/databases/$(database)/documents/users/$(userId))
      );
    }

    // PRODUCTOS (Inventario)
    match /products/{productId} {
      allow read: if true;
      // Permitir actualizar stock a usuarios autenticados (clientes anónimos incluidos)
      allow update: if request.auth != null; 
      allow create, delete: if hasAdminRole('administrator');
    }

    // PEDIDOS (Orders)
    match /orders/{orderId} {
      // Cualquier cliente autenticado (anónimo o no) puede crear un pedido
      allow create: if request.auth != null;
      // Solo el staff administrativo o el propio dueño del pedido pueden leerlo
      allow read, update: if request.auth != null && (
        isStaff() || resource.data.customerId == request.auth.uid
      );
      // Permitir borrar solo a administradores
      allow delete: if hasAdminRole('administrator');
    }

    // NUEVO: NECESIDADES DE PRODUCCIÓN
    match /production_needs/{needId} {
      allow create: if request.auth != null;
      allow read, update: if isStaff();
      allow delete: if hasAdminRole('administrator');
    }

    // CONFIGURACIONES GLOBALES
    match /settings/{settingId} {
      allow read: if true;
      allow write: if hasAdminRole('administrator');
    }

    // ASOCIADOS / PARTNERS
    match /partners/{partnerId} {
      allow read, write: if hasAdminRole('administrator');
    }

    // INGREDIENTES
    match /ingredients/{ingredientId} {
      // Permitir lectura a cualquier staff
      allow read: if isStaff();
      // Permitir escritura solo a administradores o asistentes de producción
      allow write: if hasAdminRole('administrator') || hasAdminRole('asistente');
    }

    // COMPRAS
    match /purchases/{purchaseId} {
      // Permitir lectura a cualquier staff
      allow read: if isStaff();
      // Permitir escritura solo a administradores o asistentes
      allow write: if hasAdminRole('administrator') || hasAdminRole('asistente');
    }

    // Asegurar que el administrador pueda editar cualquier campo de productos
    match /products/{productId} {
      allow write: if hasAdminRole('administrator');
    }
  }
}
