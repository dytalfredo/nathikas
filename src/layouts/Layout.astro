---
import "../styles/global.css";
import LoadingScreen from "../components/LoadingScreen";
import CustomAlert from "../components/ui/CustomAlert";
import { pwaInfo } from "virtual:pwa-info";

interface Props {
    title: string;
    showLoading?: boolean;
    enablePWA?: boolean;
}

const { title, showLoading = true, enablePWA = false } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content="Nathikas - Sabor mexicano que explota"
        />
        <meta name="viewport" content="width=device-width" />
        <meta name="theme-color" content="#FDF6E3" />
        <link rel="icon" type="image/png" href="/images/logo.png" />
        <link rel="apple-touch-icon" href="/images/logo.png" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&family=Chicle&display=swap"
            rel="stylesheet"
        />
        {
            enablePWA && pwaInfo && (
                <Fragment set:html={pwaInfo.webManifest.linkTag} />
            )
        }
    </head>
    <body class="bg-[#FDF6E3] text-[#3E2723] min-h-screen relative">
        <script is:inline>
            // Anti-flash script: hide content immediately if loading screen should show
            if (!sessionStorage.getItem("hasSeenLoadingScreen")) {
                document.documentElement.classList.add("app-loading");
            }
        </script>
        <style is:global>
            html.app-loading #main-content {
                opacity: 0;
                visibility: hidden;
            }
        </style>

        {showLoading && <LoadingScreen client:only="react" />}
        <CustomAlert client:only="react" />
        <div
            id="main-content"
            class="transition-opacity duration-700 ease-in-out"
        >
            <slot />
        </div>
    </body>
</html>
