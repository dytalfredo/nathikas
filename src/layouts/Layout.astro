---
import "../styles/global.css";
import LoadingScreen from "../components/LoadingScreen";
import CustomAlert from "../components/ui/CustomAlert";
import AuthInitializer from "../components/AuthInitializer";
import { pwaInfo } from "virtual:pwa-info";

interface Props {
    title: string;
    showLoading?: boolean;
    enablePWA?: boolean;
}

const { title, showLoading = true, enablePWA = false } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content="Nathikas - Gomitas Enchiladas y Dulces Mexicanos"
        />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    </head>
    <body class="bg-[#FDF6E3] text-[#3E2723] min-h-screen relative">
        <!-- ... loader ... -->

        {showLoading && <LoadingScreen client:only="react" />}
        <CustomAlert client:only="react" />
        <AuthInitializer client:only="react" />
        <div
            id="main-content"
            class="transition-opacity duration-700 ease-in-out"
        >
            <slot />
        </div>
    </body>
</html>
