rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar roles administrativos
    function hasAdminRole(role) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isStaff() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['administrator', 'asistente', 'vendedor', 'puntoDeVenta'];
    }

    // PERFILES DE USUARIO
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isStaff());
      allow write: if request.auth != null && request.auth.uid == userId && (
        !('role' in request.resource.data) || 
        resource.data.role == request.resource.data.role ||
        !exists(/databases/$(database)/documents/users/$(userId))
      );
    }

    // PRODUCTOS (Inventario)
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if hasAdminRole('administrator');
    }

    // PEDIDOS (Orders)
    match /orders/{orderId} {
      // El backend (Netlify Function con Admin SDK) es el único que crea pedidos
      allow create: if false; 
      allow read, update: if request.auth != null && (
        isStaff() || resource.data.customerId == request.auth.uid
      );
      allow delete: if hasAdminRole('administrator');
    }

    // NECESIDADES DE PRODUCCIÓN
    match /production_needs/{needId} {
      // El backend es el único que crea necesidades
      allow create: if false;
      allow read, update: if isStaff();
      allow delete: if hasAdminRole('administrator');
    }

    // CONFIGURACIONES GLOBALES
    match /settings/{settingId} {
      allow read: if true;
      allow write: if hasAdminRole('administrator');
    }

    // PUNTOS DE RETIRO
    match /pickup_points/{pointId} {
      allow read: if true;
      allow create, delete: if hasAdminRole('administrator');
      allow update: if hasAdminRole('administrator') || hasAdminRole('puntoDeVenta');
    }

    // PROMOCIONES
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if hasAdminRole('administrator');
    }

    // ASOCIADOS / PARTNERS
    match /partners/{partnerId} {
      allow read, write: if hasAdminRole('administrator');
    }

    // INGREDIENTES
    match /ingredients/{ingredientId} {
      allow read: if isStaff();
      allow write: if hasAdminRole('administrator') || hasAdminRole('asistente');
    }

    // COMPRAS
    match /purchases/{purchaseId} {
      allow read: if isStaff();
      allow write: if hasAdminRole('administrator') || hasAdminRole('asistente');
    }
  }
}
