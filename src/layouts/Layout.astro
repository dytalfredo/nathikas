---
import "../styles/global.css";
import LoadingScreen from "../components/LoadingScreen";
import CustomAlert from "../components/ui/CustomAlert";
import { pwaInfo } from "virtual:pwa-info";

interface Props {
    title: string;
    showLoading?: boolean;
    enablePWA?: boolean;
}

const { title, showLoading = true, enablePWA = false } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content="Nathikas - Sabor mexicano que explota"
        />
        <meta name="viewport" content="width=device-width" />
        <meta name="theme-color" content="#FDF6E3" />
        <link rel="icon" type="image/png" href="/images/logo.png" />
        <link rel="apple-touch-icon" href="/images/logo.png" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&family=Chicle&display=swap"
            rel="stylesheet"
        />
        {
            enablePWA && pwaInfo && (
                <Fragment set:html={pwaInfo.webManifest.linkTag} />
            )
        }
    </head>
    <body class="bg-[#FDF6E3] text-[#3E2723] min-h-screen relative">
        <!-- Static Loader for SSR (prevents FOUC) -->
        <div
            id="static-loader"
            class="fixed inset-0 z-[20] bg-[#FDF6E3] flex flex-col items-center justify-center p-4 overflow-hidden gap-8 transition-opacity duration-500"
        >
            <div
                class="absolute inset-0 opacity-10 pointer-events-none"
                style="background-image: url('/recursos/papel-picado-bottom.png'); background-size: cover;"
            >
            </div>
            <div
                class="w-64 h-64 flex items-center justify-center flex-none relative"
            >
                <div
                    class="w-16 h-16"
                    style="background-image: url('/images/AnimacionLoginSprite.png'); background-size: 512px 64px; background-repeat: no-repeat; transform: scale(4);"
                >
                </div>
            </div>
            <h1
                class="text-3xl md:text-5xl font-heading text-[#D91A2A] text-center drop-shadow-md z-10 font-bold"
            >
                Gomitas Enchiladas
            </h1>
            <!-- Placeholder for loading bar -->
            <div
                class="w-64 h-4 bg-gray-200 rounded-full overflow-hidden border-2 border-[#D91A2A]/20 flex-none z-10"
            >
                <div class="h-full bg-[#F2A900] w-0"></div>
            </div>
        </div>

        <script is:inline>
            // Immediately check if we should even show the loader
            if (sessionStorage.getItem("hasSeenLoadingScreen")) {
                const loader = document.getElementById("static-loader");
                if (loader) loader.style.display = "none";
            } else {
                document.documentElement.classList.add("app-loading");
            }
        </script>
        <style is:global>
            html.app-loading #main-content {
                opacity: 0;
                visibility: hidden;
            }
        </style>

        {showLoading && <LoadingScreen client:only="react" />}
        <CustomAlert client:only="react" />
        <div
            id="main-content"
            class="transition-opacity duration-700 ease-in-out"
        >
            <slot />
        </div>
    </body>
</html>
